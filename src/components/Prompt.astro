---
import { siteConfig } from "@/config/site";

/*
 * Terminal-style section label: monospaced, sentence case, no uppercase
 * transform, with the leading `❯` picked out in the accent color. Defaults
 * to `siteConfig.tagline`, so the prompt is defined once and reused.
 */
interface Props {
  /** Label text. A leading `❯` is rendered as the accent prompt character. */
  text?: string;
  class?: string;
}

const { text = siteConfig.tagline, class: className } = Astro.props;
const command = text.replace(/^❯\s*/, "");
const hasPrompt = command !== text;
---

<p class:list={["prompt", className]}>
  {hasPrompt ? [<span class="prompt__prefix">❯</span>, ` ${command}`] : text}
</p>

<style>
  .prompt {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .prompt__prefix {
    color: var(--accent);
  }
</style>