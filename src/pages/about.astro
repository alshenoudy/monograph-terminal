---
import { getCollection } from "astro:content";
import Experience from "@/components/Experience.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { heroConfig } from "@/config/hero";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name} — what it publishes and how it is organized.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <h1 class="pagehead-title">{siteConfig.name}</h1>
        <p class="pagehead-description">{siteConfig.about}</p>
      </header>

      <div class="prose">
        <h2>What gets published here</h2>
        <p>
          Long-form notes on building software: the decision behind a change, what it cost, and what
          would be done differently next time. Posts are written to be read once, carefully, rather
          than skimmed.
        </p>

        <h2>How it is written</h2>
        <p>
          Every post aims to be reproducible and honest about trade-offs. If something did not work,
          that goes in too. Corrections are made in place, with the update date shown at the top of
          the post.
        </p>

        <h2>Who writes it</h2>
        <p>
          {siteConfig.authorName} writes everything published here. The archive is organized by
          category for the shape of the work, and by tag for the specific topics covered.
        </p>

        <h2>Experience</h2>
        <Experience experience={heroConfig.experience} />

        <h2>Get in touch</h2>
        <p>
          Questions, corrections, and requests are welcome through the <a href="/contact/">contact page</a>.
        </p>
        {
          siteConfig.email && (
            <p>You can also email <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> directly.</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
